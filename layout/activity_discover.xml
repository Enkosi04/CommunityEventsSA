<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F9FF">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="#1976D2">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/discover"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/discover_header_desc"
            android:textColor="#E3F2FD"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Search Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="18dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_menu_search"
                    android:tint="#1976D2" />

                <EditText
                    android:id="@+id/input_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="@string/search_hint"
                    android:singleLine="true"
                    android:background="@android:color/transparent"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="#222222"
                    android:textSize="15sp"
                    android:importantForAutofill="no" />

                <ImageButton
                    android:id="@+id/button_search"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@android:drawable/ic_menu_search"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/discover" />
            </LinearLayout>

            <!-- Filters -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_events"
                android:textColor="#222222"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <Spinner
                android:id="@+id/filter_category"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp" />

            <Spinner
                android:id="@+id/filter_location"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/button_date_filter"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/select_date"
                android:backgroundTint="#1976D2"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/button_apply_filters"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/apply_filters"
                android:backgroundTint="#1976D2"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/events_near_you"
                android:textColor="#222222"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Event Card 1 - Community Fun Run -->
            <LinearLayout
                android:id="@+id/event_card_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">

                <ImageView
                    android:id="@+id/event_image_1"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/funrun"
                    android:contentDescription="@string/event_fun_run" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/event_fun_run"
                    android:textColor="#1976D2"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <Button
                    android:id="@+id/button_view_event_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/view_event"
                    android:backgroundTint="#1976D2"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- Event Card 2 - Community Food Drive -->
            <LinearLayout
                android:id="@+id/event_card_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">

                <ImageView
                    android:id="@+id/event_image_2"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/food"
                    android:contentDescription="@string/event_food_drive" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/event_food_drive"
                    android:textColor="#1976D2"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <Button
                    android:id="@+id/button_view_event_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/view_event"
                    android:backgroundTint="#1976D2"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- Event Card 3 - Community Clean-Up -->
            <LinearLayout
                android:id="@+id/event_card_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">

                <ImageView
                    android:id="@+id/event_image_3"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/event"
                    android:contentDescription="@string/event_cleanup" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/event_cleanup"
                    android:textColor="#1976D2"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <Button
                    android:id="@+id/button_view_event_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/view_event"
                    android:backgroundTint="#1976D2"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- Event Card 4 - Youth Sports Day -->
            <LinearLayout
                android:id="@+id/event_card_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">

                <ImageView
                    android:id="@+id/event_image_4"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/run"
                    android:contentDescription="@string/event_sports_day" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/event_sports_day"
                    android:textColor="#1976D2"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <Button
                    android:id="@+id/button_view_event_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/view_event"
                    android:backgroundTint="#1976D2"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- Event Card 5 - Career Workshop -->
            <LinearLayout
                android:id="@+id/event_card_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">

                <ImageView
                    android:id="@+id/event_image_5"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/workshop"
                    android:contentDescription="@string/event_workshop" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/event_workshop"
                    android:textColor="#1976D2"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <Button
                    android:id="@+id/button_view_event_5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/view_event"
                    android:backgroundTint="#1976D2"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:columnCount="4"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_columnWeight="1"
            android:text="@string/home"
            android:textColor="#555555"
            android:backgroundTint="#FFFFFF"
            android:textSize="10sp"
            android:drawableTop="@android:drawable/ic_menu_today" />

        <Button
            android:id="@+id/nav_discover"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_columnWeight="1"
            android:text="@string/discover"
            android:textColor="#1976D2"
            android:backgroundTint="#FFFFFF"
            android:textSize="10sp"
            android:drawableTop="@android:drawable/ic_menu_search" />

        <Button
            android:id="@+id/nav_bookmarks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_columnWeight="1"
            android:text="@string/saved"
            android:textColor="#555555"
            android:backgroundTint="#FFFFFF"
            android:textSize="10sp"
            android:drawableTop="@android:drawable/btn_star_big_on" />

        <Button
            android:id="@+id/nav_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_columnWeight="1"
            android:text="@string/settings"
            android:textColor="#555555"
            android:backgroundTint="#FFFFFF"
            android:textSize="10sp"
            android:drawableTop="@android:drawable/ic_menu_preferences" />
    </GridLayout>
</LinearLayout>
