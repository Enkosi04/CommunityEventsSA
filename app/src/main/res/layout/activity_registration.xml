<?xml version="1.0" encoding="utf-8"?>
<!--
  File: activity_registration.xml
  Purpose: Registration screen - where a new user creates an account.
  User enters a username, email and password, then taps Register.
  The account is created with Firebase Authentication and the user
  can then log in and use the app.
  Most text uses @string/... so it translates to English, Afrikaans and isiZulu.
-->

<!-- Root layout: Vertical LinearLayout, everything stacks top to bottom -->
<!-- White background (#FFFFFF), 20dp padding so nothing touches the edges -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF"
    tools:context=".Registration">

    <!-- Page Title: "Register" - big, bold and centred at the top -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:gravity="center"
        android:text="@string/register" />

    <!-- Subtitle: Tells user what to do - e.g. "Sign in to continue" -->
    <!-- Gives a short instruction under the title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/sign_in_continue" />

    <!-- Label for username field: "Username" -->
    <!-- Label is above the input so user knows what to type -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:text="@string/username" />

    <!-- Username input: User types their chosen username here -->
    <!-- inputType="textPersonName" shows normal text keyboard with capital first letter -->
    <!-- id et_reg_username is used in Registration.kt to read the username -->
    <EditText
        android:id="@+id/et_reg_username"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="@string/username"
        android:inputType="textPersonName" />

    <!-- Label for email field: "Email Address" -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:text="@string/email_address" />

    <!-- Email input: User types their email here -->
    <!-- inputType="textEmailAddress" shows the @ keyboard on the phone -->
    <!-- id et_reg_email is used in Registration.kt to read the email -->
    <EditText
        android:id="@+id/et_reg_email"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="@string/email_address"
        android:inputType="textEmailAddress" />

    <!-- Label for password field: "Password" -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:text="@string/password" />

    <!-- Password input: User types their password here -->
    <!-- inputType="textPassword" hides the text as dots ••• for privacy -->
    <!-- id et_reg_password is used in Registration.kt to read the password -->
    <EditText
        android:id="@+id/et_reg_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/password"
        android:inputType="textPassword" />

    <!-- Register button: Main action on this screen -->
    <!-- When clicked, Registration.kt creates a new user with Firebase Auth -->
    <!-- Blue background (#2196F3) matches the app theme -->
    <Button
        android:id="@+id/btn_register"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:text="@string/register"
        android:backgroundTint="#2196F3"
        android:textColor="#FFFFFF" />

    <!-- Link to Login: For users who already have an account -->
    <!-- Looks like text, but in Kotlin it has a click listener to open Login Activity -->
    <!-- NOTE: This text is hardcoded in English - should be moved to @string/ for translation -->
    <TextView
        android:id="@+id/tv_goto_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Already have an account? Login"
        android:textColor="#2196F3" />

    <!-- Social icons row: WhatsApp, Facebook and Email icons at the bottom -->
    <!-- Currently decorative - shows other ways users can contact / share the app -->
    <!-- Horizontal layout with gravity="center" so icons sit in the middle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="20dp">

        <!-- WhatsApp icon -->
        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="10dp"
            android:src="@drawable/whatsapp" />

        <!-- Facebook icon -->
        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="10dp"
            android:src="@drawable/facebook" />

        <!-- Email icon -->
        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="10dp"
            android:src="@drawable/email" />
    </LinearLayout>
</LinearLayout>
