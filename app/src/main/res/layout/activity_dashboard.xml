<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F9FF">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:background="#1976D2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/member_label"
                android:textColor="#E3F2FD"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/button_notifications"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_dialog_info"
            android:tint="#FFFFFF"
            android:background="@android:color/transparent"
            android:contentDescription="Notifications" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/text_welcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/good_afternoon"
                android:textColor="#222222"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_sub_header"
                android:textColor="#666666"
                android:textSize="15sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp" />

            <!-- Search Bar Trigger -->
            <LinearLayout
                android:id="@+id/search_bar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="20dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_search"
                    android:tint="#1976D2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/search_hint"
                    android:textColor="#888888"
                    android:textSize="15sp"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quick_actions"
                android:textColor="#222222"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="1"
                android:layout_marginBottom="24dp">

                <Button
                    android:id="@+id/button_discover"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnWeight="1"
                    android:text="@string/discover"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1976D2"
                    android:layout_margin="4dp"
                    android:drawableTop="@android:drawable/ic_menu_search" />

                <Button
                    android:id="@+id/button_bookmarks"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnWeight="1"
                    android:text="@string/bookmarks"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1976D2"
                    android:layout_margin="4dp"
                    android:drawableTop="@android:drawable/btn_star_big_on" />
            </GridLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recommended"
                android:textColor="#222222"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Event Card 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="12dp"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/event_title_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/event_fun_run"
                    android:textColor="#1976D2"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_view_event_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/view_event"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1976D2"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- Event Card 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="20dp"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/event_title_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/event_food_drive"
                    android:textColor="#1976D2"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_view_event_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/view_event"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1976D2"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <Button
                android:id="@+id/button_create_event"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/create_event"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#1976D2"
                android:layout_marginBottom="10dp"
                android:drawableStart="@android:drawable/ic_menu_add" />
        </LinearLayout>
    </ScrollView>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:columnCount="4"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <Button
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_columnWeight="1"
            android:text="@string/home"
            android:textColor="#1976D2"
            android:backgroundTint="#FFFFFF"
            android:textSize="9sp"
            android:drawableTop="@android:drawable/ic_menu_today"
            android:padding="4dp" />

        <Button
            android:id="@+id/nav_discover"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_columnWeight="1"
            android:text="@string/discover"
            android:textColor="#555555"
            android:backgroundTint="#FFFFFF"
            android:textSize="9sp"
            android:drawableTop="@android:drawable/ic_menu_search"
            android:padding="4dp" />

        <Button
            android:id="@+id/nav_bookmarks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_columnWeight="1"
            android:text="@string/saved"
            android:textColor="#555555"
            android:backgroundTint="#FFFFFF"
            android:textSize="9sp"
            android:drawableTop="@android:drawable/btn_star_big_on"
            android:padding="4dp" />

        <Button
            android:id="@+id/nav_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_columnWeight="1"
            android:text="@string/settings"
            android:textColor="#555555"
            android:backgroundTint="#FFFFFF"
            android:textSize="9sp"
            android:drawableTop="@android:drawable/ic_menu_preferences"
            android:padding="4dp" />
    </GridLayout>
</LinearLayout>