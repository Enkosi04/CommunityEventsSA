<?xml version="1.0" encoding="utf-8"?>
<!--
  File: activity_bookmarks.xml
  Purpose: Bookmarks screen - shows all events the user saved.
  If the user has no saved events, it shows the "empty" message.
  If they do, the events are added dynamically into bookmark_list_container
  by Bookmarks.kt from Firebase / Room offline cache.
  All text uses @string/... so it translates to English, Afrikaans and isiZulu.
-->

<!-- Root layout: Vertical, everything stacks top to bottom -->
<!-- Light blue-grey background (#F5F9FF) for a clean look -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F9FF"
    tools:context=".Bookmarks">

    <!-- Page Header: Blue bar at the top with the page title -->
    <!-- 65dp tall, blue background (#1976D2) matches the app theme -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="#1976D2">

        <!-- Header Title: "My Bookmarks" - white, bold, 22sp -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_bookmarks"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Description: Short text explaining what this screen is for -->
    <!-- e.g. "Your saved events will appear here" -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bookmarks_desc"
        android:textColor="#555555"
        android:textSize="15sp"
        android:padding="16dp" />

    <!-- Empty State Message: Shown ONLY when user has no bookmarks -->
    <!-- FIXED: Added textSize and textColor - before it used default system size -->
    <!-- android:visibility="gone" means hidden by default, Kotlin shows it when list is empty -->
    <!-- id text_empty_bookmarks is used in Bookmarks.kt to show / hide this -->
    <TextView
        android:id="@+id/text_empty_bookmarks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/empty_bookmarks"
        android:textColor="#888888"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginTop="50dp"
        android:visibility="gone" />

    <!-- Scrollable area: Lets the list scroll if there are many bookmarks -->
    <!-- layout_weight="1" makes it take all the space left between description and bottom nav -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Bookmark List Container: Empty container in XML -->
        <!-- FIXED: This is where Bookmarks.kt adds event cards at runtime -->
        <!-- Each saved event becomes a card view added here in code -->
        <LinearLayout
            android:id="@+id/bookmark_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
            <!-- Dynamic bookmarks will be added here by Kotlin code -->
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation: 4 buttons to move between main screens -->
    <!-- GridLayout with 4 equal columns - Home, Discover, Saved, Settings -->
    <!-- White background with shadow (elevation) so it floats above the content -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:columnCount="4"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <!-- Nav Button: Home - goes to Home / Dashboard screen -->
        <!-- Grey (#555555) because this is NOT the current screen -->
        <Button
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_columnWeight="1"
            android:text="@string/home"
            android:textColor="#555555"
            android:backgroundTint="#FFFFFF"
            android:textSize="9sp"
            android:drawableTop="@android:drawable/ic_menu_today"
            android:padding="4dp" />

        <!-- Nav Button: Discover - goes to Discover / Search events screen -->
        <Button
            android:id="@+id/nav_discover"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_columnWeight="1"
            android:text="@string/discover"
            android:textColor="#555555"
            android:backgroundTint="#FFFFFF"
            android:textSize="9sp"
            android:drawableTop="@android:drawable/ic_menu_search"
            android:padding="4dp" />

        <!-- Nav Button: Saved / Bookmarks - THIS screen, so it is highlighted blue -->
        <!-- Blue text (#1976D2) tells the user "you are here" -->
        <Button
            android:id="@+id/nav_bookmarks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_columnWeight="1"
            android:text="@string/saved"
            android:textColor="#1976D2"
            android:backgroundTint="#FFFFFF"
            android:textSize="9sp"
            android:drawableTop="@android:drawable/btn_star_big_on"
            android:padding="4dp" />

        <!-- Nav Button: Settings - goes to Settings / Language / Logout screen -->
        <Button
            android:id="@+id/nav_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_columnWeight="1"
            android:text="@string/settings"
            android:textColor="#555555"
            android:backgroundTint="#FFFFFF"
            android:textSize="9sp"
            android:drawableTop="@android:drawable/ic_menu_preferences"
            android:padding="4dp" />
    </GridLayout>
</LinearLayout>
