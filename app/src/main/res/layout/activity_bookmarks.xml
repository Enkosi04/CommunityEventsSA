<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F9FF">

    <!-- Page Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="#1976D2">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_bookmarks"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bookmarks_desc"
        android:textColor="#555555"
        android:textSize="15sp"
        android:padding="16dp" />

    <TextView
        android:id="@+id/text_empty_bookmarks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/empty_bookmarks"
        android:gravity="center"
        android:layout_marginTop="50dp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/bookmark_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
            <!-- Dynamic bookmarks will be added here -->
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:columnCount="4"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <Button
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_columnWeight="1"
            android:text="@string/home"
            android:textColor="#555555"
            android:backgroundTint="#FFFFFF"
            android:textSize="9sp"
            android:drawableTop="@android:drawable/ic_menu_today"
            android:padding="4dp" />

        <Button
            android:id="@+id/nav_discover"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_columnWeight="1"
            android:text="@string/discover"
            android:textColor="#555555"
            android:backgroundTint="#FFFFFF"
            android:textSize="9sp"
            android:drawableTop="@android:drawable/ic_menu_search"
            android:padding="4dp" />

        <Button
            android:id="@+id/nav_bookmarks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_columnWeight="1"
            android:text="@string/saved"
            android:textColor="#1976D2"
            android:backgroundTint="#FFFFFF"
            android:textSize="9sp"
            android:drawableTop="@android:drawable/btn_star_big_on"
            android:padding="4dp" />

        <Button
            android:id="@+id/nav_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_columnWeight="1"
            android:text="@string/settings"
            android:textColor="#555555"
            android:backgroundTint="#FFFFFF"
            android:textSize="9sp"
            android:drawableTop="@android:drawable/ic_menu_preferences"
            android:padding="4dp" />
    </GridLayout>
</LinearLayout>